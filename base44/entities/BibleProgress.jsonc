{
  "name": "BibleProgress",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "book": {
      "type": "string"
    },
    "chapter": {
      "type": "number"
    },
    "read_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_email",
    "book",
    "chapter",
    "read_date"
  ],
  "rls": {
    "create": null,
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}