{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "to_email": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": [
    "from_email",
    "to_email",
    "message"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.from_email": "{{user.email}}"
        },
        {
          "data.to_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "data.from_email": "{{user.email}}"
    },
    "delete": {
      "data.from_email": "{{user.email}}"
    }
  }
}