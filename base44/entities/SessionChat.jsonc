{
  "name": "SessionChat",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_question": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "session_id",
    "author_email",
    "message"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "data.author_email": "{{user.email}}"
    },
    "delete": {
      "data.author_email": "{{user.email}}"
    }
  }
}