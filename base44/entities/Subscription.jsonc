{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "checkout_id": {
      "type": "string",
      "description": "Wix checkout session ID \u2014 used to link webhook to user"
    },
    "subscription_id": {
      "type": "string",
      "description": "Wix subscription contract ID from order_approved webhook"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "ended"
      ],
      "default": "pending"
    },
    "plan": {
      "type": "string",
      "default": "leader_premium"
    }
  },
  "required": [
    "user_email",
    "checkout_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}